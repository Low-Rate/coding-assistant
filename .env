# Coding Assistant Configuration
# LLM Backend: ollama or litellm
LLM_BACKEND=litellm

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=deepseek-r1:7b
OLLAMA_FAST_MODEL=llama3.2:3b

# LiteLLM settings (use double underscore for nested settings)
LITELLM__BASE_URL=https://litellm.lrate.top
LITELLM__API_KEY=sk-I1HJZZvUEIp0LmKFQEKDTw
LITELLM__TIMEOUT=120.0
LITELLM__DEFAULT_MODEL=gpt-oss-20b
LITELLM__REASONING_MODEL=deepseek-v4.1-flash
LITELLM__FAST_MODEL=gpt-oss-20b
LITELLM__EMBEDDING_MODEL=text-embedding-3-small

# Vector DB settings
VECTOR_PERSIST_DIRECTORY=C:\Users\ljs\.coding-assistant\chroma
VECTOR_COLLECTION_NAME=codebase
VECTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_EMBEDDING_DEVICE=cpu

# Indexer settings
INDEXER_ENABLED=true
INDEXER_WATCH_INTERVAL=1.0
INDEXER_MAX_FILE_SIZE=1000000
INDEXER_CHUNK_SIZE=500
INDEXER_CHUNK_OVERLAP=50

# Memory settings
MEMORY_MAX_CONVERSATION_TOKENS=8000
MEMORY_SUMMARY_THRESHOLD=6000
MEMORY_SUMMARY_MODEL=llama3.2:3b
MEMORY_MAX_HISTORY_MESSAGES=50
MEMORY_PROJECT_CONTEXT_TOKENS=2000

# TUI settings
TUI_THEME=dark
TUI_SHOW_LINE_NUMBERS=true
TUI_MOUSE_SUPPORT=true
TUI_ANIMATION_DURATION=0.15

# General settings
DATA_DIR=C:\Users\ljs\.coding-assistant
LOG_LEVEL=INFO
AUTO_INDEX_ON_STARTUP=true
CONFIRM_DESTRUCTIVE_TOOLS=true